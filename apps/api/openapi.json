{
  "openapi": "3.1.0",
  "info": {
    "title": "Omnichannel AI Inbox API",
    "version": "0.1.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Live",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Live Health Live Get"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Ready",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/organization": {
      "get": {
        "tags": [
          "inbox"
        ],
        "summary": "Get Organization",
        "operationId": "get_organization_organization_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganizationRead"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "The request is not valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/conversations": {
      "get": {
        "tags": [
          "inbox"
        ],
        "summary": "List Conversations",
        "operationId": "list_conversations_conversations_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ConversationRead"
                  },
                  "type": "array",
                  "title": "Response List Conversations Conversations Get"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "The request is not valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/conversations/{conversation_id}/messages": {
      "get": {
        "tags": [
          "inbox"
        ],
        "summary": "List Messages",
        "operationId": "list_messages_conversations__conversation_id__messages_get",
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Conversation Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MessageRead"
                  },
                  "title": "Response List Messages Conversations  Conversation Id  Messages Get"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "The request is not valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "inbox"
        ],
        "summary": "Send Staff Reply",
        "operationId": "send_staff_reply_conversations__conversation_id__messages_post",
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Conversation Id"
            }
          },
          {
            "name": "idempotency-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ],
              "description": "Any unique string per reply. Resending with the same key returns the first message instead of creating a second one",
              "title": "Idempotency-Key"
            },
            "description": "Any unique string per reply. Resending with the same key returns the first message instead of creating a second one"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MessageCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageRead"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "The request is not valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/webhooks/rahulcoolgram": {
      "post": {
        "tags": [
          "webhooks"
        ],
        "summary": "Receive Rahulcoolgram",
        "operationId": "receive_rahulcoolgram_webhooks_rahulcoolgram_post",
        "parameters": [
          {
            "name": "x-rahulcoolgram-key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "X-Rahulcoolgram-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RahulCoolGramWebhook"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookReceipt"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "The request is not valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConversationRead": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "contact_name": {
            "type": "string",
            "title": "Contact Name",
            "description": "The customer's display name on their channel"
          },
          "channel": {
            "type": "string",
            "title": "Channel",
            "description": "The app the customer wrote from, e.g. rahulcoolgram"
          },
          "status": {
            "$ref": "#/components/schemas/ConversationStatus"
          },
          "last_message_at": {
            "type": "string",
            "format": "date-time",
            "title": "Last Message At",
            "description": "When the latest message was sent (UTC). The inbox sorts by this"
          },
          "last_message_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Message Text",
            "description": "Text of the latest message, for the preview line"
          }
        },
        "type": "object",
        "required": [
          "id",
          "contact_name",
          "channel",
          "status",
          "last_message_at",
          "last_message_text"
        ],
        "title": "ConversationRead"
      },
      "ConversationStatus": {
        "type": "string",
        "enum": [
          "open",
          "resolved"
        ],
        "title": "ConversationStatus"
      },
      "DeliveryStatus": {
        "type": "string",
        "enum": [
          "queued",
          "sent",
          "failed"
        ],
        "title": "DeliveryStatus",
        "description": "Outgoing messages only. Incoming messages have no delivery status."
      },
      "Direction": {
        "type": "string",
        "enum": [
          "in",
          "out"
        ],
        "title": "Direction"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Stable machine-readable code, e.g. not_found"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Human-readable explanation"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details",
            "description": "Per-field problems; only on validation_error"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "description": "Shape of every error response."
      },
      "FieldError": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field",
            "description": "Path to the bad input, e.g. body.text"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "field",
          "message"
        ],
        "title": "FieldError"
      },
      "MessageCreate": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "MessageCreate",
        "description": "Staff reply body. All other message fields are set by the server."
      },
      "MessageRead": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Conversation Id",
            "description": "The conversation this message belongs to"
          },
          "direction": {
            "$ref": "#/components/schemas/Direction",
            "description": "in = from the customer, out = to the customer"
          },
          "sender_type": {
            "$ref": "#/components/schemas/SenderType",
            "description": "contact = the customer, staff = a store employee, ai = the AI agent"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "delivery_status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DeliveryStatus"
              },
              {
                "type": "null"
              }
            ],
            "description": "Outgoing messages only: queued, sent or failed"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error",
            "description": "Why delivery failed"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "When the message was sent (UTC)"
          }
        },
        "type": "object",
        "required": [
          "id",
          "conversation_id",
          "direction",
          "sender_type",
          "text",
          "delivery_status",
          "error",
          "created_at"
        ],
        "title": "MessageRead"
      },
      "OrganizationRead": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "OrganizationRead"
      },
      "RahulCoolGramCustomer": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Id"
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "username": {
            "type": "string",
            "maxLength": 100,
            "title": "Username"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "username"
        ],
        "title": "RahulCoolGramCustomer"
      },
      "RahulCoolGramWebhook": {
        "properties": {
          "message_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Message Id"
          },
          "customer": {
            "$ref": "#/components/schemas/RahulCoolGramCustomer"
          },
          "text": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text"
          },
          "sent_at": {
            "type": "string",
            "format": "date-time",
            "title": "Sent At"
          }
        },
        "type": "object",
        "required": [
          "message_id",
          "customer",
          "text",
          "sent_at"
        ],
        "title": "RahulCoolGramWebhook",
        "description": "Body RahulCoolGram sends for every customer message."
      },
      "SenderType": {
        "type": "string",
        "enum": [
          "contact",
          "staff",
          "ai"
        ],
        "title": "SenderType"
      },
      "WebhookReceipt": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "saved",
              "duplicate"
            ],
            "title": "Status",
            "description": "duplicate = this message_id was already received; nothing changed"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "WebhookReceipt"
      }
    }
  }
}
