APP_NAME=Omnichannel AI Inbox API
ENVIRONMENT=dev
LOG_LEVEL=INFO
LOG_JSON=false
DATABASE_URL=postgresql+asyncpg://inbox:inbox@localhost:5432/inbox
CORS_ORIGINS=["http://localhost:3000"]
RAHULCOOLGRAM_URL=http://localhost:8100
RAHULCOOLGRAM_API_KEY=dev-secret

# Groq: key and model name from console.groq.com
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=
GROQ_TIMEOUT_SECONDS=20
GROQ_MAX_RETRIES=2
